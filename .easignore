# Exclude native directories — forces EAS to run a clean expo prebuild
/ios/
/android/

# Firebase functions not needed for mobile builds
/functions/

# Exclude large local files
*.aab
*.apk
*.ipa
app-production-*.aab
/builds/
/dist/
/dist-staging/
/node_modules/

# Exclude unnecessary files
node_modules/.cache/
.expo/
.idea/
.vscode/

# Local keystore (EAS has its own)
android/app/release.keystore
android/app/upload.keystore
keystore.properties

# App Store Connect API key — used by eas submit, not needed in the build tarball
credentials/
*.p8

# Logs and temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Marketing media + web exports — build-irrelevant; these pushed the archive
# to 646 MB and made uploads flake (EPIPE/socket hang up, Jul 2026)
marketing-video/
dist-web/
dist-web-demo/
docs/
audit-*.json
quote-replay-priced-audit*.json
