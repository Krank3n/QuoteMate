# Exclude local build artifacts from EAS uploads
android/app/build/
android/build/
android/.gradle/
ios/build/
ios/Pods/

# Exclude large local files
*.aab
*.apk
*.ipa
app-production-*.aab

# Exclude unnecessary files
node_modules/.cache/
.expo/
.idea/
.vscode/

# Local keystore (EAS has its own)
android/app/release.keystore
android/app/upload.keystore
keystore.properties

# Logs and temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
