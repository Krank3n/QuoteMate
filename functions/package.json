{
  "name": "quotemate-functions",
  "version": "1.0.0",
  "description": "Firebase Functions for QuoteMate subscription management",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "audit:quote-quality": "npx ts-node scripts/quoteQualityOracle.ts",
    "audit:replay-priced": "npx ts-node scripts/replayRecentQuotesWithPrices.ts"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@google-analytics/data": "^6.1.0",
    "@sparticuz/chromium": "^143.0.4",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^9.15.1",
    "jpeg-js": "^0.4.4",
    "node-fetch": "^2.7.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^24.39.1",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@types/cors": "^2.8.17",
    "@types/node-fetch": "^2.6.13",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  },
  "private": true
}
