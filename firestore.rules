rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return emailVerified() && request.auth.uid == userId;
    }

    // Let brand-new email/password signups record platform metadata before
    // they are forced to verify. All real app data remains verified-only.
    match /users/{userId}/settings/registrationInfo {
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow read: if isOwner(userId);
      allow delete: if false;
    }

    // Users can read/write their own user document and ALL subcollections,
    // but only after their email has been verified.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Unified documents collection (phase-1 dual-write mirror of quotes+invoices).
    // Owner-only access; backend triggers use admin SDK and bypass rules.
    // Explicit match is redundant with the wildcard above but documents intent
    // and gives a stable place to tighten rules in later phases.
    match /users/{userId}/documents/{docId} {
      allow read, write: if isOwner(userId);
    }

    // Jobs — owner-only (phase 8). Same pattern as documents: functionally
    // redundant with the wildcard, kept explicit so the rules file is
    // self-describing.
    match /users/{userId}/jobs/{jobId} {
      allow read, write: if isOwner(userId);
    }

    // Users can only read their own subscription data
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      // Only backend (admin) can write subscription data
      allow write: if false;
    }

    // Quote acceptance tokens - only Cloud Functions (admin) can write
    // Public read needed for acceptance page
    match /quoteAcceptanceTokens/{tokenId} {
      allow read: if true;
      allow write: if false;
    }

    // App config (version checks etc.) — public read, admin-only write
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Supplier profiles — any verified auth user can read, only verified owner can write
    match /suppliers/{supplierId} {
      allow read: if emailVerified();
      allow write: if emailVerified() && request.auth.uid == resource.data.ownerUid;
      allow create: if emailVerified() && request.auth.uid == request.resource.data.ownerUid;

      // Price items — any verified auth user can read, only supplier owner can write
      match /priceItems/{itemId} {
        allow read: if emailVerified();
        allow write: if emailVerified()
          && request.auth.uid == get(/databases/$(database)/documents/suppliers/$(supplierId)).data.ownerUid;
      }

      // Subscribers — tradie can create/delete own doc, supplier owner can read all
      match /subscribers/{tradieUid} {
        allow read: if emailVerified()
          && (request.auth.uid == tradieUid
              || request.auth.uid == get(/databases/$(database)/documents/suppliers/$(supplierId)).data.ownerUid);
        allow create, delete: if emailVerified() && request.auth.uid == tradieUid;
      }
    }

    // Pending links — no client access (Cloud Functions only)
    match /pendingLinks/{linkId} {
      allow read, write: if false;
    }

    // Square payment-order index — written by Cloud Functions (link mint or
    // in-app payment record). Owner can read for status display; only Cloud
    // Functions write.
    match /squarePaymentOrders/{orderId} {
      allow read: if emailVerified()
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Square payment-link index — same access pattern.
    match /squarePaymentLinks/{linkId} {
      allow read: if emailVerified()
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Square reverse-lookup: paymentId → {userId, invoiceId|quoteId}.
    // Written by the webhook after successful reconciliation so dispute
    // events (which carry disputed payment id but not order id) can route
    // back to the invoice/quote. Read allowed for the owning tradie so the
    // client can resolve disputes linked in the UI.
    match /squarePayments/{paymentId} {
      allow read: if emailVerified()
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Admin audit log — Cloud Functions only
    match /adminAuditLog/{entryId} {
      allow read, write: if false;
    }

    // Admin notes + CRM events on user docs — already covered by /users/{userId}/{document=**}
    // but explicit deny-client-read-across-users is enforced by the default match below.

    // Admin notes on supplier docs — Cloud Functions only
    match /suppliers/{supplierId}/adminNotes/{noteId} {
      allow read, write: if false;
    }

    // Personal AI ticket board — Cloud Functions only (admin-gated callables +
    // the key-gated agent bridge). No client reads/writes Firestore directly.
    match /tickets/{ticketId} {
      allow read, write: if false;
    }

    // Lead outreach pipeline — Cloud Functions only (admin-gated callables).
    // No client should ever read or write these directly.
    match /leads/{leadId} {
      allow read, write: if false;
      match /{sub=**} {
        allow read, write: if false;
      }
    }
    match /leadSuppression/{key} {
      allow read, write: if false;
    }
    match /leadCampaigns/{campaignId} {
      allow read, write: if false;
    }
    match /leadOutreachConfig/{docId} {
      allow read, write: if false;
    }

    // Default: deny all access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
