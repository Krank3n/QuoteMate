rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document and ALL subcollections
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only read their own subscription data
    match /subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Only backend (admin) can write subscription data
      allow write: if false;
    }

    // Quote acceptance tokens - only Cloud Functions (admin) can write
    // Public read needed for acceptance page
    match /quoteAcceptanceTokens/{tokenId} {
      allow read: if true;
      allow write: if false;
    }

    // App config (version checks etc.) — public read, admin-only write
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Supplier profiles — any auth user can read, only owner can write
    match /suppliers/{supplierId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;

      // Price items — any auth user can read, only supplier owner can write
      match /priceItems/{itemId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/suppliers/$(supplierId)).data.ownerUid;
      }

      // Subscribers — tradie can create/delete own doc, supplier owner can read all
      match /subscribers/{tradieUid} {
        allow read: if request.auth != null
          && (request.auth.uid == tradieUid
              || request.auth.uid == get(/databases/$(database)/documents/suppliers/$(supplierId)).data.ownerUid);
        allow create, delete: if request.auth != null && request.auth.uid == tradieUid;
      }
    }

    // Pending links — no client access (Cloud Functions only)
    match /pendingLinks/{linkId} {
      allow read, write: if false;
    }

    // Default: deny all access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
